# 프로바이더 스위치 (SPEC.md 1장)
LLM_PROVIDER=anthropic
OCR_PROVIDER=tesseract
RAG_BACKEND=faiss
STT_PROVIDER=local

# Anthropic (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# AWS Bedrock (LLM_PROVIDER=bedrock, RAG_BACKEND=bedrock_kb)
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_KB_ID=

# Tesseract (OCR_PROVIDER=tesseract) — 미설치 시 tesseract 실행 파일 경로 지정
TESSERACT_CMD=

# CORS (개발용 프론트 오리진)
CORS_ORIGINS=http://localhost:5173
